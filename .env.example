# ACBU Frontend — Environment Variables Example
#
# Copy this file to .env.local and fill in the values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Do NOT add secrets (private keys, passwords, tokens) with the NEXT_PUBLIC_ prefix.

# ─── API ────────────────────────────────────────────────────────────────────────

# Base URL of the ACBU backend API (e.g. https://api.acbu.example.com)
NEXT_PUBLIC_API_BASE_URL=

# Request timeout in milliseconds (default: 10000)
NEXT_PUBLIC_API_TIMEOUT=10000

# ─── Stellar / Soroban ──────────────────────────────────────────────────────────

# Stellar Horizon server URL
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC server URL
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ─── ACBU Asset ─────────────────────────────────────────────────────────────────

# Asset code for the ACBU token (e.g. ACBU)
NEXT_PUBLIC_ACBU_ASSET_CODE=ACBU

# Stellar account address of the ACBU asset issuer
NEXT_PUBLIC_ACBU_ASSET_ISSUER=

# Stellar account address of the demo fiat issuer
NEXT_PUBLIC_DEMO_FIAT_ISSUER=

# ─── Features ───────────────────────────────────────────────────────────────────

# Set to "true" to enable the Bills payment feature
NEXT_PUBLIC_BILLS_ENABLED=false

# ─── Support ────────────────────────────────────────────────────────────────────

# URL for the support intake form
NEXT_PUBLIC_SUPPORT_INTAKE_URL=

# ─── Debugging ──────────────────────────────────────────────────────────────────

# Set to "true" to enable verbose debug logging in the browser console
NEXT_PUBLIC_DEBUG=false
